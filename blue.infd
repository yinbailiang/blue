# blue —— 分布式 Agent 系统期望状态
#
# 顶层键 = 服务名 = services/<name>/ 目录名。
# 每个服务的值是该服务 ServiceTemplate(...) 的配置实例；
# supervisor 是唯一保留的非服务顶层键。

# 密钥统一放在 secrets.toml（已 gitignore，模板见 secrets.example.toml），
# 由下面这行通过 !file 导入；文件或键缺失时对应取值为 null（noexist）。

!file p"secrets.toml" as toml import .agent.api_key as agent_api_key, .bus.password as bus_password

!from p"services/browser/service.infd" import ServiceTemplate as BrowserService
!from p"services/bus/service.infd" import ServiceTemplate as BusService
!from p"services/registry/service.infd" import ServiceTemplate as RegistryService
!from p"services/session/service.infd" import ServiceTemplate as SessionService
!from p"services/agent/service.infd" import ServiceTemplate as AgentService
!from p"services/webui/service.infd" import ServiceTemplate as WebUIService
!from p"services/echo/service.infd" import ServiceTemplate as EchoService
!from p"services/clock/service.infd" import ServiceTemplate as ClockService
!from p"services/text_stats/service.infd" import ServiceTemplate as TextStatsService
!from p"services/read_file/service.infd" import ServiceTemplate as ReadFileService
!from p"services/write_file/service.infd" import ServiceTemplate as WriteFileService
!from p"services/edit_file/service.infd" import ServiceTemplate as EditFileService
!from p"services/shell/service.infd" import ServiceTemplate as ShellService
!from p"services/weather/service.infd" import ServiceTemplate as WeatherService
!from p"services/mcp_bridge/service.infd" import ServiceTemplate as McpBridgeService

supervisor {
  state_dir: str = ".blue"
  reconcile_interval: <float, positive> = 2.0
  shutdown_timeout: <float, positive> = 10.0
  log_max_bytes: <int, positive> = 10485760
  log_backups: <int, range(0, 20)> = 3
  restart_backoff: <float, positive> = 0.5
  restart_backoff_max: <float, positive> = 30.0
  restart_max_attempts: <int, range(1, 100)> = 10
  stable_after: <float, positive> = 60.0
  registry_ttl: <float, positive> = 15.0
  registry_sweep_interval: <float, positive> = 2.0
  uv_frozen: bool = true
}

bus = BusService(
  mode = "managed",
  vhost = "blue",
  user = "guest",
  password = $bus_password,
)

registry = RegistryService()

session = SessionService()

agent = AgentService(
  provider = "deepseek",
  model = "deepseek-v4-flash",
  api_key = $agent_api_key,
  max_steps = 512,
  tool_timeout = 1800.0,
)

webui = WebUIService()

#echo = EchoService()
clock = ClockService()
text_stats = TextStatsService()
# 文件类工具的 workdir 与 shell 同义：缺省为项目根，相对路径按项目根解析
read_file = ReadFileService()
write_file = WriteFileService()
edit_file = EditFileService()

# workdir 缺省为项目根（blue.infd 所在目录）；可设为绝对路径或相对项目根的路径
shell = ShellService()

# 天气查询：默认走 wttr.in，可改 base_url / timeout
weather = WeatherService()

# 无头 Firefox 截图：截图以图片附件回到模型（agent 真的能「看见」页面）
browser = BrowserService()

# MCP 客户端桥：把外部 MCP server（stdio）的工具接进目录。
# 工具集是声明式的：只有 tools 里列出的 <server>__<tool> 会注册；声明的工具在
# server 上不存在时桥启动失败（fail loud）。启用时把下面三行取消注释：
#mcp_bridge = McpBridgeService(
#  tools = ["fs__read_file"],
#  servers = [{name = "fs", command = "npx", args = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}],
#)

# UI 客户端不纳入 supervisor 调谐，手工运行：
#   uv run --package blue-service-chat blue-service-chat --interactive
#   uv run --package blue-service-inspect blue-service-inspect tools
