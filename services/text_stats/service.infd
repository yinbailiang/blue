~ServiceTemplate {
}

service {
  name = "text_stats"
  kind = "tool"
  package = "blue-service-text-stats"
  module = "blue_service_text_stats"
  depends_on = ["bus"]
  depends_contracts = ["tool"]
  depends_sdk = ["tool"]
  restart = "always"
  stop_timeout = 5.0
  startup_timeout = 30.0
  readiness = "process"

  # 冒烟：激活后确认自己的工具真的注册上了（否则 apply 判失败并回滚）
  smoke_tools = ["text_stats"]
}
