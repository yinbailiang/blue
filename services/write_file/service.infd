~ServiceTemplate {
  workdir: <str?> = null
}

service {
  name = "write_file"
  kind = "tool"
  package = "blue-service-write-file"
  module = "blue_service_write_file"
  depends_on = ["bus"]
  depends_contracts = ["tool"]
  depends_sdk = ["tool"]
  restart = "always"
  stop_timeout = 5.0
  startup_timeout = 30.0
  readiness = "process"
}
