~ServiceTemplate {
  shell: str = ""
  workdir: <path?> = null
  max_sessions: <int, range(1, 16)> = 6
  cols: <int, range(20, 400)> = 100
  rows: <int, range(5, 200)> = 30
  scrollback: <int, range(0, 10000)> = 2000
  font_path: <path?, any(?, extension("ttf", "otf", "ttc"))> = null
  font_size: <int, range(8, 40)> = 15
  idle_ttl: <float, positive> = 1800.0
  background: <str, regex("(#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|rgb:([0-9a-fA-F]{1,4}/){2}[0-9a-fA-F]{1,4})")> = "#0b1020"
  foreground: <str, regex("(#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|rgb:([0-9a-fA-F]{1,4}/){2}[0-9a-fA-F]{1,4})")> = "#e5e7eb"
  palette: <
    list
    each(all(
      field(name, str)
      field(color, regex("(#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|rgb:([0-9a-fA-F]{1,4}/){2}[0-9a-fA-F]{1,4})"))
    ))
    size(0, 16)
  > = []
  respond_to_queries: bool = true
}

service {
  name = "terminal"
  kind = "tool"
  package = "blue-service-terminal"
  module = "blue_service_terminal"
  depends_on = ["bus"]
  depends_contracts = ["tool"]
  depends_sdk = ["tool"]
  restart = "always"
  stop_timeout = 10.0
  startup_timeout = 30.0
  readiness = "process"

  # 冒烟：本服务注册多个终端工具，只要求至少注册上 1 个
  smoke_min_tools = 1
}
