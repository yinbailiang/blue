~ServiceTemplate {
  workdir: <str?> = null
  max_edge: <int, range(320, 4096)> = 1568
  max_bytes: <int, range(1024, 134217728)> = 33554432
}

service {
  name = "view_image"
  kind = "tool"
  package = "blue-service-view-image"
  module = "blue_service_view_image"
  depends_on = ["bus"]
  depends_contracts = ["tool"]
  depends_sdk = ["tool"]
  restart = "always"
  stop_timeout = 5.0
  startup_timeout = 30.0
  readiness = "process"

  # 冒烟：激活后确认自己的工具真的注册上了（否则 apply 判失败并回滚）
  smoke_tools = ["view_image"]
}
