~ServiceTemplate {
  driver_bin: str = "geckodriver"
  browser_bin: <str?> = null
  timeout: <float, positive> = 90.0
  default_width: <int, range(320, 3840)> = 1280
  default_height: <int, range(240, 2160)> = 900
  max_edge: <int, range(320, 4096)> = 1568
}

service {
  name = "browser_ops"
  kind = "tool"
  package = "blue-service-browser-ops"
  module = "blue_service_browser_ops"
  depends_on = ["bus"]
  depends_contracts = ["tool"]
  depends_sdk = ["tool"]
  restart = "always"
  stop_timeout = 30.0
  startup_timeout = 40.0
  readiness = "process"

  # 冒烟：激活后确认自己的工具真的注册上了（否则 apply 判失败并回滚）
  smoke_tools = ["browser_operate"]
}
