~ServiceTemplate {
}

service {
  name = "history_search"
  kind = "tool"
  package = "blue-service-history_search"
  module = "blue_service_history_search"
  depends_on = ["bus", "session"]
  depends_contracts = ["tool", "session"]
  depends_sdk = ["tool"]
  restart = "always"
  stop_timeout = 30.0
  startup_timeout = 30.0
  readiness = "process"

  # 冒烟：激活后确认自己的工具真的注册上了（否则 apply 判失败并回滚）
  smoke_tools = ["history_search"]
}
